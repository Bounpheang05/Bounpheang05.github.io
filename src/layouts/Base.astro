---
import '../styles/global.css';
import { site } from '../data/site';
import { languages, localePath, ui, type Lang } from '../data/i18n';

interface Props { lang: Lang; title?: string; image?: string }
const { lang, title, image = '/og.jpg' } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const imageUrl = new URL(image, Astro.site).href;
const barePath = Astro.url.pathname.replace(/^\/(en|th)(?=\/|$)/, '') || '/';
const home = localePath(lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href="/favicon.png" />
    {languages.map((l) => (
      <link rel="alternate" hreflang={l.code} href={new URL(localePath(l.code, barePath), Astro.site).href} />
    ))}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="z-20 bg-paper sm:sticky sm:top-0">
      <div class="page flex flex-wrap items-center justify-between gap-x-6 py-2">
        <a href={home} class="flex min-h-11 items-center gap-3 text-lg font-medium">
          <img src="/mark.png" alt="" width="42" height="34" class="logo" />
          {site.name}
        </a>
        <div class="flex flex-wrap items-center gap-x-2">
          <nav class="flex gap-5">
            <a href={`${home}#work`} class="flex min-h-11 items-center hover:underline">{t.work}</a>
            <a href={`${home}#contact`} class="flex min-h-11 items-center hover:underline">{t.contact}</a>
          </nav>
          <nav class="flex" aria-label={t.language}>
            {languages.map((l) => (
              <a
                href={localePath(l.code, barePath)}
                lang={l.code}
                aria-label={l.name}
                aria-current={l.code === lang ? 'true' : undefined}
                class="lang flex min-h-11 min-w-11 items-center justify-center"
              >
                {l.label}
              </a>
            ))}
          </nav>
          <button id="theme" type="button" aria-label={t.theme} class="flex size-11 cursor-pointer items-center justify-center">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
              <path d="M12 3a9 9 0 0 1 0 18Z" fill="currentColor" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <section id="contact" aria-labelledby="contact-heading" class="border-t border-line py-20 sm:py-28">
      <div class="page grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 id="contact-heading" class="display text-3xl sm:text-4xl">{t.contactHeading}</h2>
          <p class="mt-4 max-w-xl text-lg text-stone">{t.contactBody}</p>
        </div>
        <ul class="self-center border-t border-line">
          <li>
            <a class="channel" href={site.whatsappUrl} target="_blank" rel="noopener">
              <span class="icon whatsapp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" /></svg></span>
              <span>
                <span class="block text-stone">{t.whatsapp}</span>
                <span class="value" lang="en">{site.phone}</span>
              </span>
            </a>
          </li>
          <li>
            <a class="channel" href={site.facebookUrl} target="_blank" rel="noopener">
              <span class="icon facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" /></svg></span>
              <span>
                <span class="block text-stone">{t.facebook}</span>
                <span class="value" lang="en">{site.facebookName}</span>
              </span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <footer class="border-t border-line text-stone">
      <div class="page flex flex-wrap items-center justify-between gap-4 py-6">
        <a href={home} class="flex items-center gap-3 text-ink">
          <img src="/mark.png" alt="" width="32" height="26" class="logo" />
          {site.name}
        </a>
        <p>© {new Date().getFullYear()} {site.name}</p>
      </div>
    </footer>

    <style>
      .lang { color: var(--stone); }
      .lang:hover { color: var(--ink); }
      .lang[aria-current] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--ink); text-decoration-thickness: 1px; text-underline-offset: 6px; }
      .channel { display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
      .channel:hover .value { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
      .icon { display: block; flex: none; width: 2.25rem; }
      .icon svg { display: block; width: 100%; }
      .whatsapp svg { fill: #1aa851; }
      .facebook svg { fill: #0866ff; }
      .value { display: block; font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height: 1.25; }
    </style>

    <script>
      document.querySelector('#theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
